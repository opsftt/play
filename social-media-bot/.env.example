# ── Anthropic (Claude) ──────────────────────────────────────────────────────
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# ── Google Drive / Sheets ────────────────────────────────────────────────────
# Path to your Google service account JSON credentials file
GOOGLE_SERVICE_ACCOUNT_JSON=credentials/google_service_account.json
# Drive folder IDs to watch (comma-separated)
DRIVE_WATCH_FOLDER_IDS=your_folder_id_1,your_folder_id_2
# Google Sheet ID where drafts will be written
GOOGLE_SHEET_ID=your_google_sheet_id_here

# ── Webhook server ────────────────────────────────────────────────────────────
WEBHOOK_SECRET=change_me_to_a_random_string
PORT=5050

# ── Brand voice ──────────────────────────────────────────────────────────────
# Short description of your brand used in every prompt
BRAND_NAME=Freedom Team Trading
BRAND_VOICE=energetic, educational, empowering, results-driven
BRAND_NICHE=forex and futures trading education
NICHE_HASHTAGS=#forex #futurestrading #tradinglifestyle #daytrader #forextrader #tradingstrategy #financialfreedom #freedomteamtrading

# ── Processing ────────────────────────────────────────────────────────────────
# Whisper model: tiny | base | small | medium | large  (larger = more accurate, slower)
WHISPER_MODEL=base
# Temp directory for downloaded/processed videos
TEMP_DIR=/tmp/smbot

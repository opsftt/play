# ── Slack ────────────────────────────────────────────────────────────────────
# Bot token (xoxb-...) from OAuth & Permissions after installing the app
SLACK_BOT_TOKEN=xoxb-your-bot-token
# App-level token (xapp-...) with connections:write scope, for Socket Mode
SLACK_APP_TOKEN=xapp-your-app-token

# Channel where new tickets are posted for the team to triage (ID like C0123ABCDEF)
TRIAGE_CHANNEL=C0123ABCDEF
# Channel where the weekly KPI digest is posted (can be the same channel)
DIGEST_CHANNEL=C0123ABCDEF
# Who gets pinged on escalations / SLA breaches (e.g. <!here> or <@U0123MANAGER>)
ESCALATION_MENTION=<!here>

# Emoji name (without colons) members can react with to turn any message into a ticket
TICKET_REACTION=ticket

# ── Google Sheets ────────────────────────────────────────────────────────────
# Path to your Google service account JSON credentials file
GOOGLE_SERVICE_ACCOUNT_JSON=credentials/google_service_account.json
# Google Sheet ID used as the ticket database (share the sheet with the
# service account email as Editor)
TICKETS_SHEET_ID=your_google_sheet_id_here

# ── Operations ───────────────────────────────────────────────────────────────
TIMEZONE=America/New_York
# Day/time the weekly KPI digest is posted (local to TIMEZONE)
DIGEST_DAY=monday
DIGEST_TIME=09:00
# How often (minutes) to scan open tickets for SLA breaches
SLA_CHECK_MINUTES=30
# Prefix for ticket IDs
TICKET_PREFIX=FTT
